        { "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" }, "expr": "rate(sentinel_anpr_detections_total[1m]) * 60", "legendFormat": "Detections/min", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" }, "expr": "rate(sentinel_watchlist_hits_total[1m]) * 60", "legendFormat": "Watchlist Hits/min", "refId": "B" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.95 }, { "color": "green", "value": 0.98 }] }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "id": 21,
      "title": "ANPR OCR Accuracy — YOLOv8n + PaddleOCR Confidence",
