    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 200,
      "title": "📊 AI Inference Latency & Throughput",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15, "showPoints": "never", "spanNulls": true },
          "unit": "ms",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 30 }, { "color": "red", "value": 100 }] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "model1_p99" }, "properties": [{ "id": "color", "value": { "fixedColor": "#38bdf8", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "model2_p99" }, "properties": [{ "id": "color", "value": { "fixedColor": "#10b981", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "model3_p99" }, "properties": [{ "id": "color", "value": { "fixedColor": "#f59e0b", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "model4_p99" }, "properties": [{ "id": "color", "value": { "fixedColor": "#8b5cf6", "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 6 },
      "id": 10,
      "options": { "tooltip": { "mode": "multi", "sort": "asc" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "last"] } },
      "title": "AI Inference Latency P99 — All 4 Models (ms)",
      "type": "timeseries",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" }, "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{job=\"sentinel-model1\"}[2m])) * 1000", "legendFormat": "Model 1 — GIS/Registry P99", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" }, "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{job=\"sentinel-model2\"}[2m])) * 1000", "legendFormat": "Model 2 — ANPR/YOLOv8 P99", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" }, "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{job=\"sentinel-model3\"}[2m])) * 1000", "legendFormat": "Model 3 — VMS Federation P99", "refId": "C" },
        { "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" }, "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{job=\"sentinel-model4\"}[2m])) * 1000", "legendFormat": "Model 4 — Trajectory P99", "refId": "D" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "reqps",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }, { "color": "green", "value": 100 }] },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "id": 11,
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "title": "Request Throughput — Req/s per Model",
      "type": "timeseries",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" }, "expr": "sum(rate(http_requests_total{job=\"sentinel-model1\"}[1m]))", "legendFormat": "Model 1", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" }, "expr": "sum(rate(http_requests_total{job=\"sentinel-model2\"}[1m]))", "legendFormat": "Model 2", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" }, "expr": "sum(rate(http_requests_total{job=\"sentinel-model3\"}[1m]))", "legendFormat": "Model 3", "refId": "C" },
        { "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" }, "expr": "sum(rate(http_requests_total{job=\"sentinel-model4\"}[1m]))", "legendFormat": "Model 4", "refId": "D" }
      ]
    },

