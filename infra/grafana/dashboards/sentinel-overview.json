        "overrides": [
          { "matcher": { "id": "byName", "options": "anpr.detections" }, "properties": [{ "id": "color", "value": { "fixedColor": "#38bdf8", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "alerts.critical" }, "properties": [{ "id": "color", "value": { "fixedColor": "#ef4444", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "trajectory.events" }, "properties": [{ "id": "color", "value": { "fixedColor": "#8b5cf6", "mode": "fixed" } }] }
        ]
