      "type": "stat",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" }, "expr": "avg(sentinel_stream_e2e_latency_seconds)", "instant": true, "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" },
