      "targets": [
        { "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" }, "expr": "rate(kafka_topic_messages_total{topic=\"anpr.detections\"}[1m])", "legendFormat": "anpr.detections", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" }, "expr": "rate(kafka_topic_messages_total{topic=\"alerts.critical\"}[1m])", "legendFormat": "alerts.critical", "refId": "B" },
        { "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" }, "expr": "rate(kafka_topic_messages_total{topic=\"trajectory.events\"}[1m])", "legendFormat": "trajectory.events", "refId": "C" },
        { "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" }, "expr": "rate(kafka_topic_messages_total{topic=\"vms.heartbeats\"}[1m])", "legendFormat": "vms.heartbeats", "refId": "D" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 10000 }, { "color": "red", "value": 50000 }] }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "id": 31,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center" },
      "title": "Kafka Consumer Lag",
      "type": "stat",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" }, "expr": "sum(kafka_consumer_group_lag{group=~\"sentinel.*\"})", "instant": true, "refId": "A" }
      ]
    },

