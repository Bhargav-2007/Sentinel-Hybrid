    { "title": "Incidents", "url": "/d/sentinel-incidents", "type": "dashboards", "targetBlank": false }
  ],
  "liveNow": true,
  "refresh": "5s",
  "tags": ["sentinel", "infrastructure", "sre", "postgres", "redis", "minio"],
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "Asia/Kolkata",
  "title": "🖥️ Gujarat Sentinel — SRE Infrastructure & Cluster Telemetry",
  "uid": "sentinel-infrastructure",
  "version": 1,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "⚡ Hardware Resources & Compute Capacity",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 }] }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center" },
      "title": "Cluster CPU Utilization",
      "type": "stat",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" }, "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)", "instant": true, "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percent",
          "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 }] }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center" },
      "title": "Cluster RAM Utilization",
      "type": "stat",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" }, "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100", "instant": true, "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percentunit",
          "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.85 }, { "color": "green", "value": 0.95 }] }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center" },
      "title": "Redis Cache Hit Ratio (VAHAN)",
      "type": "stat",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" }, "expr": "rate(redis_keyspace_hits_total[1m]) / (rate(redis_keyspace_hits_total[1m]) + rate(redis_keyspace_misses_total[1m]))", "instant": true, "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 100 }, { "color": "red", "value": 180 }] }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center" },
      "title": "PostgreSQL Active Connections",
      "type": "stat",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" }, "expr": "pg_stat_activity_count", "instant": true, "refId": "A" }]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 200,
      "title": "💾 MinIO S3 Object Storage & SHA-256 Chaining Throughput",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "unit": "iops"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "id": 10,
      "title": "MinIO Snapshot Upload IOPS",
      "type": "timeseries",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" }, "expr": "rate(minio_s3_requests_total{api=\"PutObject\"}[1m])", "legendFormat": "PutObject (Snapshots/Snippets)", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" }, "expr": "rate(minio_s3_requests_total{api=\"GetObject\"}[1m])", "legendFormat": "GetObject (Playback/Audit)", "refId": "B" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 15 },
          "unit": "Bps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "id": 11,
      "title": "Network Traffic Ingress / Egress (Bytes/s)",
      "type": "timeseries",
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" }, "expr": "rate(node_network_receive_bytes_total[1m])", "legendFormat": "Ingress (RTSP/WebRTC Streams)", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" }, "expr": "rate(node_network_transmit_bytes_total[1m])", "legendFormat": "Egress (SOC Wall Streams)", "refId": "B" }
      ]
    }
  ]
}
