        { "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" }, "expr": "sentinel_anpr_confidence_avg", "legendFormat": "Avg Confidence Score", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" }, "expr": "sentinel_anpr_plate_accuracy_ratio", "legendFormat": "Plate Match Accuracy", "refId": "B" }
      ]
    },

    {
      "collapsed": false,
