      "targets": [{ "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" }, "expr": "increase(sentinel_stream_reconnects_total[1h])", "instant": true, "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
