# =============================================================================
# Gujarat Sentinel — Hybrid CCTV Platform
# Environment Variables Template
# Copy to .env and fill in values before running docker-compose
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
SECRET_KEY=sentinel-dev-secret-change-in-production-min-32-chars

# -----------------------------------------------------------------------------
# PostgreSQL + PostGIS (shared across services)
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel_secure_pass_2026
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_secure_pass_2026@postgres:5432/sentinel

# Model-specific databases
MODEL1_DB=sentinel_model1
MODEL2_DB=sentinel_model2
MODEL3_DB=sentinel_model3
MODEL4_DB=sentinel_model4
HYBRID_DB=sentinel_hybrid

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=redis_secure_pass
REDIS_CACHE_TTL=300              # seconds
CAMERA_STATUS_CACHE_TTL=30       # seconds for camera health cache

# -----------------------------------------------------------------------------
# Apache Kafka
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT   # PLAINTEXT | SSL | SASL_SSL (prod)
KAFKA_GROUP_ID_PREFIX=sentinel

# Kafka Topics
TOPIC_CAMERA_EVENTS=sentinel.camera.events
TOPIC_DETECTION_EVENTS=sentinel.detection.events
TOPIC_ALERT_EVENTS=sentinel.alert.events
TOPIC_TRACKING_EVENTS=sentinel.tracking.events
TOPIC_AUDIT_EVENTS=sentinel.audit.events
TOPIC_HEALTH_EVENTS=sentinel.health.events
TOPIC_VMS_FEDERATION=sentinel.vms.federation
TOPIC_WATCHLIST_ALERTS=sentinel.watchlist.alerts

# -----------------------------------------------------------------------------
# OpenSearch (Elasticsearch-compatible)
# -----------------------------------------------------------------------------
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=Sentinel_Strong_Pass_2026!
OPENSEARCH_INDEX_CAMERAS=sentinel-cameras
OPENSEARCH_INDEX_DETECTIONS=sentinel-detections
OPENSEARCH_INDEX_ALERTS=sentinel-alerts
OPENSEARCH_INDEX_TRACKS=sentinel-tracks

# -----------------------------------------------------------------------------
# Keycloak (OIDC / Identity Provider)
# -----------------------------------------------------------------------------
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=sentinel
KEYCLOAK_CLIENT_ID=sentinel-api
KEYCLOAK_CLIENT_SECRET=sentinel-client-secret-change-in-prod
OIDC_JWKS_URL=http://keycloak:8080/realms/sentinel/protocol/openid-connect/certs
OIDC_ISSUER=http://keycloak:8080/realms/sentinel
OIDC_AUDIENCE=sentinel-api

# Default admin credentials (development only)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_password

# -----------------------------------------------------------------------------
# OPA (Open Policy Agent) — Policy Enforcement
# -----------------------------------------------------------------------------
OPA_URL=http://opa:8181
OPA_POLICY_PATH=sentinel/authz

# -----------------------------------------------------------------------------
# OpenTelemetry (Observability)
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAMESPACE=sentinel
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1      # 10% sampling in production

# -----------------------------------------------------------------------------
# Model 1 — CCTV Registry & GIS
# -----------------------------------------------------------------------------
MODEL1_PORT=8001
MODEL1_HOST=0.0.0.0
MODEL1_DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_secure_pass_2026@postgres:5432/sentinel_model1
MODEL1_SERVICE_NAME=sentinel-model1-registry
MODEL1_MAX_BULK_CAMERAS=10000    # Max cameras per bulk import
MODEL1_GIS_SRID=4326             # WGS84 coordinate system

# -----------------------------------------------------------------------------
# Model 2 — Unified Viewer & ANPR Analytics
# -----------------------------------------------------------------------------
MODEL2_PORT=8002
MODEL2_HOST=0.0.0.0
MODEL2_DATABASE_URL=postgresql+asyncpg://sentinel:sentinel_secure_pass_2026@postgres:5432/sentinel_model2
MODEL2_SERVICE_NAME=sentinel-model2-viewer

# RTSP Consumer settings
RTSP_TCP_TRANSPORT=true
RTSP_RECONNECT_INITIAL_DELAY=2   # seconds
RTSP_RECONNECT_MAX_DELAY=30      # seconds
RTSP_FRAME_SAMPLE_RATE=1         # process every Nth frame (1=all, 5=every 5th)
RTSP_MAX_CONCURRENT_STREAMS=50   # max simultaneous RTSP connections

# ANPR settings
ANPR_MODEL=paddleocr             # paddleocr | easyocr
ANPR_CONFIDENCE_THRESHOLD=0.75
ANPR_ENABLE_VEHICLE_DETECTION=true
ANPR_YOLO_MODEL=yolov8n          # yolov8n | yolov8s | yolov8m

# HLS relay
HLS_SEGMENT_DURATION=2           # seconds
HLS_PLAYLIST_LENGTH=5            # segments in playlist

# Sentinel live grid (from resource page)
SENTINEL_INGEST_API=http://live.corp8.cloud/api/ingest
SENTINEL_RTSP_HOST=live.corp8.cloud
SENTINEL_RTSP_PORT=8554
SENTINEL_WEBRTC_HOST=live.corp8.cloud
SENTINEL_WEBRTC_PORT=8889

# -----------------------------------------------------------------------------
# Model 3 — VMS Federation & Middleware
# -----------------------------------------------------------------------------
MODEL3_PORT=8003
MODEL3_HOST=0.0.0.0
MODEL3_DB_URL=jdbc:postgresql://postgres:5432/sentinel_model3
MODEL3_DB_USER=sentinel
MODEL3_DB_PASSWORD=sentinel_secure_pass_2026
MODEL3_SERVICE_NAME=sentinel-model3-federation

# Federation settings
FEDERATION_ADAPTER_DISCOVERY_INTERVAL=60  # seconds
FEDERATION_EVENT_CORRELATION_WINDOW=300   # seconds (5 min)
FEDERATION_MAX_ADAPTERS=100

# Mock VMS endpoints (for demo)
MOCK_VMS_A_URL=http://mock-vms-a:9001
MOCK_VMS_B_URL=http://mock-vms-b:9002

# -----------------------------------------------------------------------------
# Model 4 — Central VMS, AI Pipeline & Vehicle Tracking
# -----------------------------------------------------------------------------
MODEL4_PORT=8004
MODEL4_HOST=0.0.0.0
MODEL4_DATABASE_URL=postgres://sentinel:sentinel_secure_pass_2026@postgres:5432/sentinel_model4
MODEL4_SERVICE_NAME=sentinel-model4-central

# Storage tiering
STORAGE_HOT_RETENTION_DAYS=7
STORAGE_WARM_RETENTION_DAYS=30
STORAGE_COLD_RETENTION_DAYS=90
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minio_access_key
S3_SECRET_KEY=minio_secret_key
S3_BUCKET_HOT=sentinel-hot
S3_BUCKET_WARM=sentinel-warm
S3_BUCKET_COLD=sentinel-cold

# AI dispatch
AI_WORKER_URL=http://model2:8002/internal/ai    # reuse model2 AI workers
ALERT_WEBHOOK_URL=                               # optional external webhook

# Vehicle tracking
TRACKING_ROUTE_STITCH_GAP_SECONDS=3600          # max gap to merge routes
TRACKING_CONFIDENCE_THRESHOLD=0.85

# -----------------------------------------------------------------------------
# Backend Hybrid — Gateway & Orchestrator
# -----------------------------------------------------------------------------
HYBRID_PORT=8000
HYBRID_HOST=0.0.0.0
HYBRID_DATABASE_URL=postgres://sentinel:sentinel_secure_pass_2026@postgres:5432/sentinel_hybrid
HYBRID_SERVICE_NAME=sentinel-hybrid-gateway

# Upstream service URLs
MODEL1_URL=http://model1:8001
MODEL2_URL=http://model2:8002
MODEL3_URL=http://model3:8003
MODEL4_URL=http://model4:8004

# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
RATE_LIMIT_BURST=100

# -----------------------------------------------------------------------------
# Mock External APIs (VAHAN, SARTHI, eGujCop, AFIS, NAFIS)
# -----------------------------------------------------------------------------
MOCK_APIS_PORT=8090
VAHAN_API_URL=http://mock-external-apis:8090/vahan
SARTHI_API_URL=http://mock-external-apis:8090/sarthi
EGUJCOP_API_URL=http://mock-external-apis:8090/egujcop
AFIS_API_URL=http://mock-external-apis:8090/afis
NAFIS_API_URL=http://mock-external-apis:8090/nafis
MOCK_API_AUTH_TOKEN=mock-token-dev-only

# -----------------------------------------------------------------------------
# RTSP Simulator (synthetic camera streams)
# -----------------------------------------------------------------------------
RTSP_SIM_PORT=8554
RTSP_SIM_CAMERA_COUNT=50         # number of synthetic cameras
RTSP_SIM_FRAME_RATE=25
RTSP_SIM_RESOLUTION=1280x720
RTSP_SIM_CODEC=h264              # h264 | h265

# -----------------------------------------------------------------------------
# Grafana + Prometheus
# -----------------------------------------------------------------------------
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_admin_pass
PROMETHEUS_PORT=9090

# -----------------------------------------------------------------------------
# Traefik (API Gateway / Load Balancer)
# -----------------------------------------------------------------------------
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8888

# -----------------------------------------------------------------------------
# TLS / mTLS (production)
# -----------------------------------------------------------------------------
TLS_ENABLED=false                # set true in production
TLS_CERT_FILE=/certs/server.crt
TLS_KEY_FILE=/certs/server.key
TLS_CA_FILE=/certs/ca.crt
MTLS_ENABLED=false               # mutual TLS between services

# -----------------------------------------------------------------------------
# Data Retention
# -----------------------------------------------------------------------------
AUDIT_RETENTION_DAYS=365         # keep audit logs for 1 year
DETECTION_RETENTION_DAYS=90      # keep detection events for 90 days
ALERT_RETENTION_DAYS=365         # keep alerts for 1 year
